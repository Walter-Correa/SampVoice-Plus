#include <winresrc.h>
#include <svplus/common/VersionRc.h>
#include "ResourceIds.hpp"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     SVPLUS_VER_MAJOR,SVPLUS_VER_MINOR,SVPLUS_VER_PATCH,0
 PRODUCTVERSION  SVPLUS_VER_MAJOR,SVPLUS_VER_MINOR,SVPLUS_VER_PATCH,0
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS       VS_FF_DEBUG
#else
 FILEFLAGS       0x0L
#endif
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_DLL
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Walter Correa\0"
            VALUE "FileDescription",  "SampVoice Plus Universal Client\0"
            VALUE "FileVersion",      SVPLUS_VER_STRING "\0"
            VALUE "InternalName",     "sampvoice.asi\0"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Walter Correa (MPL-2.0)\0"
            VALUE "OriginalFilename", "sampvoice.asi\0"
            VALUE "ProductName",      "SampVoice Plus\0"
            VALUE "ProductVersion",   SVPLUS_VER_STRING "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

